# Hinglish Smart Writing Assistant Environment Configuration

# Device settings: 'auto', 'cuda', or 'cpu'
INFERENCE_DEVICE=auto

# Model Identifiers
INDIXCLIT_MODEL_ID=ai4bharat/indicxlit-en-indic-v1.0
INDICTRANS2_MODEL_ID=ai4bharat/indictrans2-indic-en-dist-200M
BHARATGEN_PARAM1_MODEL_ID=bharatgenai/Param-1-2.9B-Instruct

# Writing Enhancement LLM Provider: 'param1', 'gemini', or 'local'
WRITING_ENHANCEMENT_PROVIDER=param1

# Optional API Keys (if using cloud/fallback generative endpoints)
GEMINI_API_KEY=
HF_TOKEN=

# Evaluation Settings
EVALUATION_DATASET_PATH=evaluation/test_dataset.json
BATCH_SIZE=8
MAX_SEQUENCE_LENGTH=256
